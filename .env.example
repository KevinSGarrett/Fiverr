# Copy this file to .env and populate with real values.
# Real secrets must only live in .env and must never be committed.
# Never commit data/sessions/ — session files contain auth credentials.

OPENAI_API_KEY=sk-your-key-here
DATABASE_URL=sqlite:///data/fiverr_research.db
LOG_LEVEL=INFO
LLM_CACHE_PATH=data/checkpoints/llm_cache.sqlite
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=FiverrResearchSystem/0.1

# ScrapFly API key for PerimeterX bypass on Fiverr collection pages.
# Get your key at https://scrapfly.io/ - free tier includes 1,000 API calls/month.
# Plans: Starter $29/mo (100K credits), ~4,000 Fiverr page fetches per run.
# Each Fiverr page costs ~25 credits (asp=True + render_js=True).
# Enable in config.yaml: collection.scrapfly.enabled: true
SCRAPFLY_API_KEY=scp-live-your-key-here
