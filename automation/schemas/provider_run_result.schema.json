{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProviderRunResult",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "status": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation_required": {
      "type": "boolean"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_artifact_path": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "provider",
    "started_at",
    "completed_at",
    "validation_required"
  ]
}
