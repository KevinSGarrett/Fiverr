{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProviderDecision",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "decisionid": {
      "type": "string"
    },
    "cycle": {
      "type": "string",
      "pattern": "^\\d{3}$"
    },
    "task_type": {
      "type": "string"
    },
    "tasktype": {
      "type": "string"
    },
    "selected_provider": {
      "type": "string",
      "enum": [
        "cursorcli",
        "claudesubscription",
        "openaiapi",
        "codexsubscription",
        "deterministiccontroller",
        "deterministicpromptfactory",
        "deterministicvalidator"
      ]
    },
    "selectedprovider": {
      "type": "string",
      "enum": [
        "cursorcli",
        "claudesubscription",
        "openaiapi",
        "codexsubscription",
        "deterministic_controller",
        "deterministic_prompt_factory",
        "deterministic_validator"
      ]
    },
    "reason": {
      "type": "string"
    },
    "billing_mode": {
      "type": "string"
    },
    "billingmode": {
      "type": "string"
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "estimatedcostusd": {
      "type": "number",
      "minimum": 0
    },
    "approved_by_policy": {
      "type": "boolean"
    },
    "approvedbypolicy": {
      "type": "boolean"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "required": [
        "decision_id",
        "cycle",
        "task_type",
        "selected_provider",
        "reason",
        "billing_mode",
        "estimated_cost_usd",
        "approved_by_policy",
        "decided_at"
      ]
    },
    {
      "required": [
        "decisionid",
        "cycle",
        "tasktype",
        "selectedprovider",
        "reason",
        "billingmode",
        "estimatedcostusd",
        "approvedbypolicy",
        "decided_at"
      ]
    }
  ]
}
