{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentRunRecord",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "cycle": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["run_id", "agent", "status"]
}
