{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PromptContract",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "cycle": {
      "type": "string",
      "pattern": "^\\d{3}$"
    },
    "agent": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "E",
        "C",
        "F",
        "D"
      ]
    },
    "agent_lane": {
      "type": "string"
    },
    "agentlane": {
      "type": "string"
    },
    "branch": {
      "type": "string",
      "pattern": "^cycle/"
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "worker": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "auto": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "fallback": {
          "type": [
            "boolean",
            "string"
          ]
        }
      },
      "required": [
        "worker",
        "model",
        "effort",
        "auto",
        "fallback"
      ]
    },
    "modelpolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "worker": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "auto": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "auto_model_selection": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "fallback": {
          "type": [
            "boolean",
            "string"
          ]
        }
      },
      "required": [
        "worker",
        "model",
        "effort"
      ]
    },
    "jira_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^SCRUM-\\d+$"
          },
          "summary": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "definition_of_done": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "project_plan_path": {
            "type": "string"
          },
          "files_or_modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "key",
          "summary"
        ]
      }
    },
    "jirascope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^SCRUM-\\d+$"
          },
          "summary": {
            "type": "string"
          },
          "acceptancecriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "definitionofdone": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "projectplanpath": {
            "type": "string"
          },
          "filesormodules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "key",
          "summary"
        ]
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedpaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockedpaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validationcommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_report_path": {
      "type": "string"
    },
    "finalreportpath": {
      "type": "string"
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "builtat": {
      "type": "string",
      "format": "date-time"
    },
    "contract_version": {
      "type": "string"
    },
    "contractversion": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "cycle",
    "agent",
    "branch"
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "agent_lane"
          ]
        },
        {
          "required": [
            "agentlane"
          ]
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "model_policy"
          ]
        },
        {
          "required": [
            "modelpolicy"
          ]
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "jira_scope"
          ]
        },
        {
          "required": [
            "jirascope"
          ]
        }
      ]
    }
  ]
}
