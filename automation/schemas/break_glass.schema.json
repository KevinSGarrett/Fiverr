{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BreakGlassApproval",
  "description": "Time-limited approval file granting elevated runner permissions for a specific action.",
  "type": "object",
  "required": ["approved_by", "approved_at", "expires_at", "allowed_actions", "reason"],
  "properties": {
    "approved_by":    { "type": "string", "description": "Person who granted approval" },
    "approved_at":    { "type": "string", "format": "date-time" },
    "expires_at":     { "type": "string", "format": "date-time", "description": "Approval expires after this time" },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Explicit list of allowed actions e.g. ['merge_main', 'rotate_secret_X']"
    },
    "reason":   { "type": "string", "description": "Why this was approved" },
    "one_time": { "type": "boolean", "default": true, "description": "Delete after first use" },
    "used_at":  { "type": ["string", "null"], "format": "date-time", "default": null }
  }
}
