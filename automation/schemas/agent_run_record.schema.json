{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "cycle",
    "agent_id",
    "agent_role",
    "prompt_path",
    "prompt_line_count",
    "prompt_task_count",
    "started_at",
    "ended_at",
    "duration_seconds",
    "exit_code",
    "status",
    "changed_files",
    "unauthorized_files",
    "commit_sha",
    "validation_passed",
    "secret_findings",
    "final_report_path",
    "errors",
    "runner_host",
    "cursor_version",
    "cursor_model",
    "model_verified_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "cycle": { "type": "integer" },
    "agent_id": { "type": "string" },
    "agent_role": { "type": "string" },
    "prompt_path": { "type": "string" },
    "prompt_line_count": { "type": "integer" },
    "prompt_task_count": { "type": "integer" },
    "started_at": { "type": "string" },
    "ended_at": { "type": "string" },
    "duration_seconds": { "type": "integer" },
    "exit_code": { "type": ["integer", "null"] },
    "status": { "type": "string" },
    "changed_files": { "type": "array" },
    "unauthorized_files": { "type": "array" },
    "commit_sha": { "type": ["string", "null"] },
    "validation_passed": { "type": "boolean" },
    "secret_findings": { "type": "array" },
    "final_report_path": { "type": "string" },
    "errors": { "type": "array" },
    "runner_host": { "type": "string" },
    "cursor_version": { "type": "string" },
    "cursor_model": { "type": "string" },
    "model_verified_at": { "type": "string" }
  }
}
