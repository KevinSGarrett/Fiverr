{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "required": [
    "generated_at",
    "source_dir",
    "entries"
  ],
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "source_dir": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_path",
          "epic_id",
          "epic_name",
          "criteria",
          "validation_commands"
        ],
        "properties": {
          "source_path": {
            "type": "string"
          },
          "epic_id": {
            "type": "string"
          },
          "epic_name": {
            "type": "string"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
