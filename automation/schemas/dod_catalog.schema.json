{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DoDCatalog",
  "anyOf": [
    {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "source_path", "epic_id", "criteria"],
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "epic_id": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation_commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": true,
      "required": ["catalog", "entries"],
      "properties": {
        "catalog": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
