{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExportManifest",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_root": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": ["generated_at", "files"]
}
