{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LiveValidationEvidence",
  "description": "Schema for V-1 through V-9 live validation evidence artifacts",
  "type": "object",
  "required": [
    "schema_version",
    "v1_status",
    "v1_run_timestamp",
    "last_updated",
    "updated_by_cycle"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "v1_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "v1_run_timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "v1_collection_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "v1_keywords_attempted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "v1_keywords_successful": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "v1_keywords_failed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "v1_total_gigs_collected": {
      "type": "integer",
      "minimum": 0
    },
    "v1_payload_archive_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "v1_collection_duration_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "v1_error_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "v2_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "v2_parsing_passed": {
      "type": "boolean"
    },
    "v2_schema_violations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "v3_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "v3_scoring_passed": {
      "type": "boolean"
    },
    "v3_golden_anchor_deviation": {
      "type": [
        "number",
        "null"
      ]
    },
    "last_updated": {
      "type": "string"
    },
    "updated_by_cycle": {
      "type": "integer"
    }
  }
}
